# Python and Jupyter
.venv/
.venv-research/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Local environment and editor files
.env
.vscode/
.idea/

# Original datasets and generated artefacts
# Directory placeholders remain tracked so a fresh clone has the expected layout.
data/raw/**/*
!data/raw/**/
!data/raw/**/.gitkeep

data/features/**/*
!data/features/**/
!data/features/**/.gitkeep

data/patches_fixed_canvas/**/*
!data/patches_fixed_canvas/**/
!data/patches_fixed_canvas/**/.gitkeep

# Generated synthetic images are reproducible and too large for Git.
# Their manifests and dataset card remain trackable.
data/synthetic/**/geometry_only/
data/synthetic/**/calibrated/

# Temporary experiment outputs
*.tmp
*.log

# Local notebook/tool caches
.cache/
